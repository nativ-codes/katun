# Katun Environment Configuration

# Supabase Configuration
# Get these from your Supabase project: Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key...
SUPABASE_ANON_KEY=eyJ...your-anon-key...

# JWT Configuration (optional - defaults derived from SUPABASE_URL)
SUPABASE_JWT_JWKS_URL=https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://your-project-id.supabase.co/auth/v1
SUPABASE_JWT_AUD=authenticated

# Development Settings
# Set to 'true' to bypass JWT validation for local testing
AUTH_DISABLED=false
AUTH_DISABLED_USER_ID=dev-user-123

# Server Configuration
PORT=3000
HOST=0.0.0.0
